# Copy to .env and fill in locally. Never commit credentials.
# Process environment takes precedence. Both keys are server-only.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_CALL_LIMIT=180
# Optional investigator; absent/unavailable model uses labeled fixed Qloo play.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_CALL_LIMIT=150

# Public entrypoint only: exact HTTPS origin; persistent volume; rights confirmation.
PUBLIC_ORIGIN=
BUDGET_DB=
QLOO_DISPLAY_APPROVED=0
QLOO_TOTAL_LIMIT=1000
NVIDIA_TOTAL_LIMIT=500
